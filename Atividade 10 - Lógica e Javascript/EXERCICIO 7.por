programa
{
	
	funcao inicio()
	{

		inteiro valor1
		inteiro valor2
		inteiro resultado

		escreva("Escreva o primeiro valor: ")
		leia(valor1)

		escreva("Escreva o segundo valor: ")
		leia(valor2)

		resultado = valor1 + valor2
		escreva("O resultado desta adição é:", resultado)

		resultado = valor1 - valor2
		escreva("\nO resultado desta subtração é:", resultado)

		resultado = valor1 * valor2
		escreva("\nO resultado desta multiplicação é:", resultado)

		resultado = valor1 / valor2
		escreva("\nO resultado desta divisão é:", resultado)
	}
}
