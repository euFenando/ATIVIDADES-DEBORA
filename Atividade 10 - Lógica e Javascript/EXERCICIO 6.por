programa
{
	
	funcao inicio()
	{
		real desconto = 0.1
		real preco
		real resultado
		
		escreva("Coloque o preço do produto: ")
		leia (preco)

		desconto = preco * 0.1
		resultado = preco - desconto

		escreva("O valor do seu produto com desconto é: ", resultado)
		
	}
}
