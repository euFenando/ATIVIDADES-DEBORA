programa
{
	
	funcao inicio()
	{
		inteiro n1
		inteiro n2
		inteiro n3
		inteiro resultado

		escreva("Escreva a primeira nota: ")
		leia(n1)

		escreva("Escreva a segunda nota: ")
		leia(n2)

		escreva("Escreva a terceira nota: ")
		leia(n3)

		resultado = ((n1 + n2 + n3) / 3)
		escreva("A média do aluno é ", resultado)
	}
}
